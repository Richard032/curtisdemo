<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.4338480">
  <PropertyGroup>
    <StartupCommand>node server.mjs</StartupCommand>
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunBuildScript>true</ShouldRunBuildScript>
    <BuildCommand>node --check server.mjs</BuildCommand>
    <BuildOutputFolder>$(MSBuildProjectDirectory)</BuildOutputFolder>
  </PropertyGroup>
</Project>
